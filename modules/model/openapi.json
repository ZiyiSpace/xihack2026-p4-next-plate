an option\nrather than writing an answer.","operationId":"ask_v1_ask_post","parameters":[{"name":"authorization","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Authorization"}},{"name":"x-api-key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/Body_ask_v1_ask_post"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"object","additionalProperties":true,"title":"Response Ask V1 Ask Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/ui":{"get":{"summary":"Ui","description":"Browser page for dish identification and free-form questions.","operationId":"ui_ui_get","responses":{"200":{"description":"Successful Response","content":{"text/html":{"schema":{"type":"string"}}}}}}}},"components":{"schemas":{"Body_ask_v1_ask_post":{"properties":{"question":{"type":"string","title":"Question","description":"One question the model answers."},"options":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Options","description":"Candidate answers, one per line; defaults to 是/否."},"state":{"type":"string","title":"State","description":"Optional situation text placed before the question.","default":""},"modality":{"type":"string","title":"Modality","default":"text"},"repeat":{"type":"integer","title":"Repeat","description":"Passes averaged over rotated option order (1-8).","default":1},"file":{"anyOf":[{"type":"string","contentMediaType":"application/octet-stream"},{"type":"null"}],"title":"File"}},"type":"object","required":["question"],"title":"Body_ask_v1_ask_post"},"Body_decide_multi_v1_decide_multi_post":{"properties":{"state":{"type":"string","title":"State"},"question":{"type":"string","title":"Question"},"options":{"type":"string","title":"Options","description":"One option per line."},"files":{"items":{"type":"string","contentMediaType":"application/octet-stream"},"type":"array","title":"Files","description":"Images sent together in one request."}},"type":"object","required":["state","question","options","files"],"title":"Body_decide_multi_v1_decide_multi_post"},"Body_decide_upload_v1_decide_upload_post":{"properties":{"state":{"type":"string","title":"State"},"question":{"type":"string","title":"Question"},"options":{"type":"string","title":"Options","description":"One option per line."},"modality":{"type":"string","title":"Modality","default":"text"},"file":{"anyOf":[{"type":"string","contentMediaType":"application/octet-stream"},{"type":"null"}],"title":"File"}},"type":"object","required":["state","question","options"],"title":"Body_decide_upload_v1_decide_upload_post"},"Body_identify_v1_identify_post":{"properties":{"file":{"type":"string","contentMediaType":"application/octet-stream","title":"File","description":"Photo of the dish."},"menu":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Menu","description":"Name of a list saved with POST /v1/menu."},"options":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Options","description":"Inline candidates, one per line."},"question":{"type":"string","title":"Question","default":"这张照片里是哪一道菜？"},"state":{"type":"string","title":"State","default":"一张在餐厅餐桌上拍摄的菜品照片。"},"include_none":{"type":"boolean","title":"Include None","description":"Add an abstain option so the whole list can be rejected.","default":false},"top_k":{"type":"integer","title":"Top K","description":"Ranked rows to return; 0 returns every candidate.","default":10},"repeat":{"type":"integer","title":"Repeat","description":"Passes averaged over rotated option order (1-8).","default":1}},"type":"object","required":["file"],"title":"Body_identify_v1_identify_post"},"DecideRequest":{"properties":{"state":{"type":"string","title":"State","description":"Situation the model should reason about."},"question":{"type":"string","title":"Question","description":"A single question answerable from the situation."},"options":{"items":{"type":"string"},"type":"array","title":"Options","description":"2-256 candidate answers."},"modality":{"type":"string","enum":["text","image","audio","video"],"title":"Modality","default":"text"},"media_base64":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Media Base64","description":"Base64 (optionally a data: URL) media payload."},"media_url":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Media Url","description":"HTTP(S) URL the server downloads the media from."},"video_frames":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Video Frames","description":"Frames to sample for video input (default 16)."}},"type":"object","required":["state","question","options"],"title":"DecideRequest","description":"One decision question, optionally carrying media inline or by URL."},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"MenuRequest":{"properties":{"name":{"type":"string","title":"Name","description":"Short identifier passed as `menu` on later calls."},"items":{"items":{"type":"string"},"type":"array","title":"Items","description":"Between 2 and 256 candidate answers."}},"type":"object","required":["name","items"],"title":"MenuRequest","description":"A named candidate list that later calls can reference by name."},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"},"input":{"title":"Input"},"ctx":{"type":"object","title":"Context"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}}}