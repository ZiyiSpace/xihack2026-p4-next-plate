# 复制为 .env 并填写。密钥绝对不要提交到仓库。
# ---- Jev-Omni 视觉服务器（菜品识别）----
JEV_BASE_URL=https://u1201184-80c0-dda3c400.westb.seetacloud.com:8443
# 密钥由服务提供方在群内单独发放。留空 = 离线规则模式，完全不调模型。
JEV_API_KEY=
JEV_TIMEOUT_S=120
# 单卡串行推理，全局并发上限（官方建议 2-3，别调高）
JEV_MAX_CONCURRENCY=2
# 认菜置信度下限：低于此值当作"没认出来"，转人工或缩小清单重试
IDENTIFY_CONFIDENCE_FLOOR=0.6
